<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Nuvem Ruscher: uma ação polkit por grupo de operações do helper.
  O pkexec escolhe a ação pelo primeiro argumento (org.freedesktop.policykit.exec.argv1).
  Ligar/desligar/reiniciar o servidor não pede senha a quem está na sessão local ativa
  (quem está no grupo docker já pode parar containers: não há ganho de privilégio), nem
  ler a saúde dos discos (disk-health: só leitura do SMART).
  Todo o resto (fstab, pacotes, configuração, atualização, desinstalação) pede a senha
  de administrador. Veja docs/04-armazenamento-e-seguranca.md.
  O exec.path é preenchido no "make install" com o caminho real do helper no prefixo
  usado (o pkexec compara o caminho já resolvido, sem links simbólicos).
-->
<policyconfig>
  <vendor>Nuvem Ruscher</vendor>
  <vendor_url>https://github.com/ruscher/nuvem-ruscher</vendor_url>
  <icon_name>io.github.ruscher.NuvemRuscher</icon_name>

  <action id="io.github.ruscher.NuvemRuscher.manage">
    <description>Configure the Nuvem Ruscher photo server</description>
    <description xml:lang="pt_BR">Configurar o servidor de fotos Nuvem Ruscher</description>
    <message>Authentication is required to configure the photo server</message>
    <message xml:lang="pt_BR">Para configurar o servidor de fotos, digite a senha de administrador</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@HELPER_PATH@</annotate>
  </action>

  <action id="io.github.ruscher.NuvemRuscher.start">
    <description>Start the Nuvem Ruscher photo server</description>
    <description xml:lang="pt_BR">Ligar o servidor de fotos Nuvem Ruscher</description>
    <message>Authentication is required to start the photo server</message>
    <message xml:lang="pt_BR">Para ligar o servidor de fotos, digite a senha de administrador</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@HELPER_PATH@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">start</annotate>
  </action>

  <action id="io.github.ruscher.NuvemRuscher.stop">
    <description>Stop the Nuvem Ruscher photo server</description>
    <description xml:lang="pt_BR">Desligar o servidor de fotos Nuvem Ruscher</description>
    <message>Authentication is required to stop the photo server</message>
    <message xml:lang="pt_BR">Para desligar o servidor de fotos, digite a senha de administrador</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@HELPER_PATH@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">stop</annotate>
  </action>

  <action id="io.github.ruscher.NuvemRuscher.restart">
    <description>Restart the Nuvem Ruscher photo server</description>
    <description xml:lang="pt_BR">Reiniciar o servidor de fotos Nuvem Ruscher</description>
    <message>Authentication is required to restart the photo server</message>
    <message xml:lang="pt_BR">Para reiniciar o servidor de fotos, digite a senha de administrador</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@HELPER_PATH@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">restart</annotate>
  </action>
  <action id="io.github.ruscher.NuvemRuscher.health">
    <description>Read the health of the disks</description>
    <description xml:lang="pt_BR">Ler a saúde dos discos</description>
    <message>Authentication is required to read the health of the disks</message>
    <message xml:lang="pt_BR">Para ler a saúde dos discos, digite a senha de administrador</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@HELPER_PATH@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">disk-health</annotate>
  </action>
</policyconfig>
