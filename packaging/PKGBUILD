# Maintainer: ruscher <https://github.com/ruscher>
#
# Dentro do repositório (cd packaging && makepkg -si), empacota a árvore local, com as
# alterações ainda não commitadas. Copiado para fora dele (AUR, repositório do
# BigLinux), baixa a tag v$pkgver do GitHub. Nos dois casos a instalação é a do
# Makefile, a mesma usada pelo Nix: nada é duplicado aqui.

pkgname=nuvem-ruscher
pkgver=2.0.0
pkgrel=1
pkgdesc="Instala, configura e cuida do Immich (alternativa livre ao Google Fotos) no BigLinux"
arch=('any')
url="https://github.com/ruscher/nuvem-ruscher"
license=('GPL-3.0-or-later')
depends=(
  'bash'
  'curl'
  'docker'
  'docker-compose'
  'glib2'
  'graphene'
  'gtk4'
  'gzip'
  'hicolor-icon-theme'
  'iproute2'
  'libadwaita'
  'pango'
  'polkit'
  'python'
  'python-gobject'
  'python-qrcode'
  'rsync'
  'shadow'
  'systemd'
  'util-linux'
)
makedepends=('gettext')
checkdepends=(
  'appstream'
  'desktop-file-utils'
  'python-pytest'
)
optdepends=(
  'exfatprogs: discos exFAT'
  'mdadm: RAID por software (redundância)'
  'ntfs-3g: discos formatados no Windows (NTFS)'
  'smartmontools: saúde dos discos (SMART)'
  'tailscale: acesso às fotos fora de casa'
  'ufw: firewall com liberação automática da porta'
)
install=nuvem-ruscher.install

# O que o build, os testes e o "make install" usam; o resto (capturas, docs) fica fora.
_files=(Makefile LICENSE pyproject.toml bin nuvem_ruscher helper data po tests)
_root="$(realpath -- "${startdir:-.}/..")"
if [[ -f ${_root}/Makefile && -f ${_root}/nuvem_ruscher/__init__.py && -f ${_root}/packaging/PKGBUILD ]]; then
  _local=1
  source=()
  sha256sums=()
else
  _local=0
  makedepends+=('git')
  source=("${pkgname}::git+${url}.git#tag=v${pkgver}")
  sha256sums=('SKIP')
fi

prepare() {
  if ((_local)); then
    rm -rf -- "${srcdir:?}/${pkgname}"
    mkdir -p -- "${srcdir}/${pkgname}"
    cp -a -- "${_files[@]/#/${_root}/}" "${srcdir}/${pkgname}/"
    # Caches locais do desenvolvedor não podem entrar no pacote.
    find "${srcdir}/${pkgname}" \( -name __pycache__ -o -name .pytest_cache -o -name .ruff_cache \) \
      -prune -exec rm -rf -- {} +
    find "${srcdir}/${pkgname}" -name '*.pyc' -delete
    echo "  -> usando a árvore local: ${_root}"
  fi
}

build() {
  make -C "${srcdir}/${pkgname}"
}

check() {
  cd "${srcdir}/${pkgname}"
  python -m pytest -p no:cacheprovider
  desktop-file-validate data/io.github.ruscher.NuvemRuscher.desktop
  appstreamcli validate --no-net data/io.github.ruscher.NuvemRuscher.metainfo.xml
}

package() {
  make -C "${srcdir}/${pkgname}" DESTDIR="${pkgdir}" PREFIX=/usr PYTHON=/usr/bin/python3 install
}
