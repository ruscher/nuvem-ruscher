#!/usr/bin/env bash
# docker falso.
# shellcheck source=_common.sh
source "${0%/*}/_common.sh"
sim_log "$@"
case "$1 $2" in
    "inspect -f") echo true ;;
    "exec immich_postgres") head -c 6000 /dev/urandom | base64 ;;
    "compose --project-directory")
        if [[ " $* " == *" config --images "* ]]; then
            printf '%s\n' ghcr.io/immich-app/immich-server:v3.2.4 docker.io/valkey/valkey:9
        fi ;;
esac
[[ " $* " == *" pull"* && ${SIM_PULL_FAIL:-0} == 1 ]] && exit 1
exit 0
