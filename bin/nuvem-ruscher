#!/usr/bin/env python3
"""Lançador do Nuvem Ruscher (código-fonte ou instalado em /usr/share/nuvem-ruscher)."""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
for candidate in (os.path.dirname(HERE), "/usr/share/nuvem-ruscher"):
    if os.path.isdir(os.path.join(candidate, "nuvem_ruscher")):
        sys.path.insert(0, candidate)
        break

from nuvem_ruscher.main import main  # noqa: E402

sys.exit(main())
