#: nuvem_ruscher/backend/base.py:282 nuvem_ruscher/ui/wizard/pages.py:111
msgid "Docker instalado"
msgstr "Docker installed"

#: nuvem_ruscher/backend/base.py:282
#, python-brace-format
msgid "Versão {v}"
msgstr "Version {v}"

#: nuvem_ruscher/backend/base.py:286
msgid "O Docker não está instalado"
msgstr "Docker is not installed"

#: nuvem_ruscher/backend/base.py:287
msgid "É o programa que roda o servidor de fotos. A instalação é automática."
msgstr "It is the program that runs the photo server. Installation is automatic."

#: nuvem_ruscher/backend/base.py:288 nuvem_ruscher/ui/wizard/pages.py:607
msgid "Instalar"
msgstr "Install"

#: nuvem_ruscher/backend/base.py:293 nuvem_ruscher/backend/base.py:295
#: nuvem_ruscher/ui/wizard/pages.py:112
msgid "Docker ligado"
msgstr "Docker running"

#: nuvem_ruscher/backend/base.py:293 nuvem_ruscher/backend/base.py:319
msgid "Aguardando a instalação"
msgstr "Waiting for the installation"

#: nuvem_ruscher/backend/base.py:299
msgid "O Docker está desligado"
msgstr "Docker is turned off"

#: nuvem_ruscher/backend/base.py:300
msgid "Vamos ligá-lo agora e deixá-lo ligando junto com o computador."
msgstr "We will turn it on now and have it start with the computer."

#: nuvem_ruscher/backend/base.py:301 nuvem_ruscher/ui/dashboard/overview.py:228
#: nuvem_ruscher/ui/dashboard/overview.py:245
msgid "Ligar"
msgstr "Turn on"

#: nuvem_ruscher/backend/base.py:306
msgid "Seu usuário pode usar o Docker"
msgstr "Your user can use Docker"

#: nuvem_ruscher/backend/base.py:311
msgid "Permissão concedida"
msgstr "Permission granted"

#: nuvem_ruscher/backend/base.py:312
msgid ""
"Já funciona. Quando puder, saia e entre na sessão para completar o ajuste."
msgstr "It already works. When you can, log out and back in to complete the change."

#: nuvem_ruscher/backend/base.py:318 nuvem_ruscher/ui/wizard/pages.py:113
msgid "Permissão para usar o Docker"
msgstr "Permission to use Docker"

#: nuvem_ruscher/backend/base.py:324
msgid "Seu usuário ainda não pode usar o Docker"
msgstr "Your user cannot use Docker yet"

#: nuvem_ruscher/backend/base.py:325
#, python-brace-format
msgid "Precisamos colocar “{user}” no grupo docker."
msgstr "We need to add “{user}” to the docker group."

#: nuvem_ruscher/backend/base.py:326
msgid "Permitir"
msgstr "Allow"

#: nuvem_ruscher/backend/base.py:330
#, python-brace-format
msgid "Memória: {size}"
msgstr "Memory: {size}"

#: nuvem_ruscher/backend/base.py:333
#, python-brace-format
msgid "O mínimo é {n} GB"
msgstr "The minimum is {n} GB"

#: nuvem_ruscher/backend/base.py:339
msgid ""
"Abaixo do recomendado. Vamos desligar o reconhecimento de rostos para caber."
msgstr "Below the recommended amount. We will turn off face recognition so it fits."

#: nuvem_ruscher/backend/base.py:345
#, python-brace-format
msgid "O Immich precisa de pelo menos {n} GB de memória."
msgstr "Immich needs at least {n} GB of memory."

#: nuvem_ruscher/backend/base.py:349
#, python-brace-format
msgid "Processador: {n} núcleos"
msgstr "Processor: {n} cores"

#: nuvem_ruscher/backend/base.py:355
msgid "Processador antigo: a inteligência artificial ficará desligada."
msgstr "Old processor: artificial intelligence will be turned off."

#: nuvem_ruscher/backend/base.py:358
msgid "Vai funcionar, mas devagar."
msgstr "It will work, but slowly."

#: nuvem_ruscher/backend/base.py:363
#, python-brace-format
msgid "Espaço no disco do sistema: {size} livres"
msgstr "Space on the system disk: {size} free"

#: nuvem_ruscher/backend/base.py:365
msgid "Os componentes ocupam cerca de 5 GB"
msgstr "The components take up about 5 GB"

#: nuvem_ruscher/backend/base.py:369 nuvem_ruscher/core/helper_protocol.py:109
msgid "Falta espaço no disco do sistema"
msgstr "Not enough space on the system disk"

#: nuvem_ruscher/backend/base.py:370
#, python-brace-format
msgid "Libere mais {size} para baixar os componentes."
msgstr "Free up {size} more to download the components."

#: nuvem_ruscher/backend/base.py:375
#, python-brace-format
msgid "Porta {p} livre"
msgstr "Port {p} is free"

#: nuvem_ruscher/backend/base.py:377
#, python-brace-format
msgid "Porta {p} já é do seu Immich"
msgstr "Port {p} already belongs to your Immich"

#: nuvem_ruscher/backend/base.py:378
#, python-brace-format
msgid " (usada por {name})"
msgstr " (used by {name})"

#: nuvem_ruscher/backend/base.py:382
#, python-brace-format
msgid "Outro programa está usando a porta {p}"
msgstr "Another program is using port {p}"

#: nuvem_ruscher/backend/base.py:383
msgid "Feche esse programa ou pare o outro Immich e verifique de novo."
msgstr "Close that program or stop the other Immich, then check again."

#: nuvem_ruscher/backend/base.py:387
msgid "Conectado à internet"
msgstr "Connected to the internet"

#: nuvem_ruscher/backend/base.py:391
msgid "Sem conexão com a internet"
msgstr "No internet connection"

#: nuvem_ruscher/backend/base.py:392
msgid "Ela só é necessária agora, para baixar os componentes."
msgstr "It is only needed now, to download the components."

#: nuvem_ruscher/backend/base.py:397
msgid "Nenhum firewall bloqueando"
msgstr "No firewall blocking"

#: nuvem_ruscher/backend/base.py:402
msgid "Firewall liberado para a rede de casa"
msgstr "Firewall open to the home network"

#: nuvem_ruscher/backend/base.py:403
#, python-brace-format
msgid "Porta {p} aberta só para redes locais e Tailscale"
msgstr "Port {p} open only to local networks and Tailscale"

#: nuvem_ruscher/backend/base.py:408
#, python-brace-format
msgid "Firewall ativo ({name})"
msgstr "Firewall active ({name})"

#: nuvem_ruscher/backend/base.py:409
#, python-brace-format
msgid ""
"Libere a porta {p} para que o celular encontre o servidor na rede de casa."
msgstr "Open port {p} so the phone can find the server on the home network."

#: nuvem_ruscher/backend/base.py:410 nuvem_ruscher/ui/dashboard/more.py:87
msgid "Liberar"
msgstr "Open port"

#: nuvem_ruscher/core/docker.py:84
msgid "Servidor"
msgstr "Server"

#: nuvem_ruscher/core/docker.py:85
msgid "Inteligência artificial"
msgstr "Artificial intelligence"

#: nuvem_ruscher/core/docker.py:86
msgid "Banco de dados"
msgstr "Database"

#: nuvem_ruscher/core/docker.py:87
msgid "Cache"
msgstr "Cache"

#: nuvem_ruscher/core/docker.py:91
msgid "Site, aplicativo e envio de fotos"
msgstr "Website, app and photo uploads"

#: nuvem_ruscher/core/docker.py:92
msgid "Rostos e busca inteligente"
msgstr "Faces and smart search"

#: nuvem_ruscher/core/docker.py:93
msgid "Álbuns, pessoas e informações das fotos"
msgstr "Albums, people and photo information"

#: nuvem_ruscher/core/docker.py:94
msgid "Fila de tarefas"
msgstr "Task queue"

#: nuvem_ruscher/core/helper_protocol.py:37
msgid "A autorização foi cancelada"
msgstr "Authorization was canceled"

#: nuvem_ruscher/core/helper_protocol.py:38
msgid ""
"Nada foi alterado. Tente de novo e digite a senha de administrador quando "
"ela for pedida."
msgstr "Nothing was changed. Try again and type the administrator password when asked."

#: nuvem_ruscher/core/helper_protocol.py:41
msgid "Seu usuário não tem permissão de administrador"
msgstr "Your user does not have administrator permission"

#: nuvem_ruscher/core/helper_protocol.py:42
msgid ""
"Peça para alguém com acesso de administrador abrir o Nuvem Ruscher e fazer "
"esta etapa."
msgstr "Ask someone with administrator access to open Nuvem Ruscher and do this step."

#: nuvem_ruscher/core/helper_protocol.py:45
msgid "O Nuvem Ruscher não está instalado por completo"
msgstr "Nuvem Ruscher is not fully installed"

#: nuvem_ruscher/core/helper_protocol.py:46
msgid ""
"Instale o pacote nuvem-ruscher (ou rode “sudo make install”) e abra o app de "
"novo."
msgstr "Install the nuvem-ruscher package (or run “sudo make install”) and open the app again."

#: nuvem_ruscher/core/helper_protocol.py:49
msgid "Um dado enviado não passou na verificação de segurança"
msgstr "Some data sent did not pass the security check"

#: nuvem_ruscher/core/helper_protocol.py:50
msgid "Nada foi alterado. Confira a pasta escolhida e tente de novo."
msgstr "Nothing was changed. Check the chosen folder and try again."

#: nuvem_ruscher/core/helper_protocol.py:53
#: nuvem_ruscher/ui/dashboard/overview.py:217
msgid "O disco das fotos não está conectado"
msgstr "The photo disk is not connected"

#: nuvem_ruscher/core/helper_protocol.py:54
msgid ""
"Conecte o disco, espere ele aparecer no gerenciador de arquivos e tente de "
"novo."
msgstr "Connect the disk, wait for it to appear in the file manager and try again."

#: nuvem_ruscher/core/helper_protocol.py:57
msgid "A pasta das fotos não está num lugar seguro"
msgstr "The photo folder is not in a safe place"

#: nuvem_ruscher/core/helper_protocol.py:58
msgid "Escolha uma pasta dentro de um disco montado. Nada foi alterado."
msgstr "Choose a folder inside a mounted disk. Nothing was changed."

#: nuvem_ruscher/core/helper_protocol.py:61
msgid "Não foi possível baixar os arquivos do Immich"
msgstr "Could not download the Immich files"

#: nuvem_ruscher/core/helper_protocol.py:62
msgid ""
"Verifique a internet e tente de novo. O processo continua de onde parou."
msgstr "Check the internet connection and try again. The process resumes where it stopped."

#: nuvem_ruscher/core/helper_protocol.py:65
msgid "A instalação de pacotes falhou"
msgstr "Package installation failed"

#: nuvem_ruscher/core/helper_protocol.py:66
msgid ""
"Atualize o sistema pela loja de programas (ou “sudo pacman -Syu”) e tente de "
"novo."
msgstr "Update the system through the software store (or “sudo pacman -Syu”) and try again."

#: nuvem_ruscher/core/helper_protocol.py:69
msgid "Esse disco já tem uma regra de montagem"
msgstr "This disk already has a mount rule"

#: nuvem_ruscher/core/helper_protocol.py:70
msgid "Ele já está configurado no sistema. Nenhuma alteração foi feita."
msgstr "It is already configured in the system. No changes were made."

#: nuvem_ruscher/core/helper_protocol.py:73
msgid "A regra de montagem não passou na verificação"
msgstr "The mount rule did not pass the check"

#: nuvem_ruscher/core/helper_protocol.py:74
msgid "Nada foi alterado: o arquivo original foi restaurado automaticamente."
msgstr "Nothing was changed: the original file was restored automatically."

#: nuvem_ruscher/core/helper_protocol.py:77
msgid "Esse tipo de disco não pode ser montado automaticamente"
msgstr "This type of disk cannot be mounted automatically"

#: nuvem_ruscher/core/helper_protocol.py:78
msgid ""
"O servidor ainda funciona, mas só depois que você entrar na sessão e abrir o "
"disco."
msgstr "The server still works, but only after you log in and open the disk."

#: nuvem_ruscher/core/helper_protocol.py:81
msgid "Existe um banco de dados antigo sem a senha correspondente"
msgstr "There is an old database without its matching password"

#: nuvem_ruscher/core/helper_protocol.py:82
msgid ""
"Para não perder nada, a instalação parou. Veja os detalhes técnicos para "
"recuperar."
msgstr "To avoid losing anything, the installation stopped. See the technical details to recover."

#: nuvem_ruscher/core/helper_protocol.py:85
#: nuvem_ruscher/ui/dashboard/overview.py:212
msgid "O servidor não conseguiu ligar"
msgstr "The server could not start"

#: nuvem_ruscher/core/helper_protocol.py:86
msgid ""
"Confira se o disco das fotos está conectado e veja os registros para mais "
"detalhes."
msgstr "Check that the photo disk is connected and see the logs for more details."

#: nuvem_ruscher/core/helper_protocol.py:89
msgid "O servidor ainda não foi instalado"
msgstr "The server has not been installed yet"

#: nuvem_ruscher/core/helper_protocol.py:90
msgid "Rode o assistente de instalação primeiro."
msgstr "Run the setup assistant first."

#: nuvem_ruscher/core/helper_protocol.py:93
#: nuvem_ruscher/ui/dashboard/overview.py:202
msgid "O servidor está desligado"
msgstr "The server is turned off"

#: nuvem_ruscher/core/helper_protocol.py:94
msgid "Ligue o servidor e tente de novo."
msgstr "Turn on the server and try again."

#: nuvem_ruscher/core/helper_protocol.py:97
msgid "O backup do banco de dados falhou"
msgstr "The database backup failed"

#: nuvem_ruscher/core/helper_protocol.py:98
msgid "Confira o espaço livre no disco das fotos e tente de novo."
msgstr "Check the free space on the photo disk and try again."

#: nuvem_ruscher/core/helper_protocol.py:101
msgid "A atualização não deu certo, mas tudo voltou como estava"
msgstr "The update did not work, but everything is back as it was"

#: nuvem_ruscher/core/helper_protocol.py:102
msgid ""
"Seu servidor continua na versão anterior, com todos os dados. Veja os "
"detalhes técnicos."
msgstr "Your server is still on the previous version, with all its data. See the technical details."

#: nuvem_ruscher/core/helper_protocol.py:105
msgid "A atualização falhou e a volta automática também"
msgstr "The update failed and so did the automatic rollback"

#: nuvem_ruscher/core/helper_protocol.py:106
msgid ""
"Suas fotos estão seguras no disco. Veja os detalhes técnicos: há uma cópia "
"do banco guardada."
msgstr "Your photos are safe on the disk. See the technical details: a copy of the database was kept."

#: nuvem_ruscher/core/helper_protocol.py:110
msgid "Libere espaço e tente de novo."
msgstr "Free up space and try again."

#: nuvem_ruscher/core/helper_protocol.py:113
msgid "Não foi possível ajustar o firewall"
msgstr "Could not adjust the firewall"

#: nuvem_ruscher/core/helper_protocol.py:114
msgid ""
"Você pode liberar a porta 2283 manualmente nas configurações do firewall."
msgstr "You can open port 2283 manually in the firewall settings."

#: nuvem_ruscher/core/helper_protocol.py:117
msgid "Algo inesperado aconteceu"
msgstr "Something unexpected happened"

#: nuvem_ruscher/core/helper_protocol.py:118
msgid ""
"Nada nas suas fotos foi alterado. Veja os detalhes técnicos e tente de novo."
msgstr "Nothing in your photos was changed. See the technical details and try again."

#: nuvem_ruscher/core/storage.py:196
msgid ""
"O banco de dados do Immich não fica nesse disco: ele vai para o disco "
"interno, como a documentação oficial exige."
msgstr "The Immich database does not go on this disk: it goes on the internal disk, as the official documentation requires."

#: nuvem_ruscher/core/storage.py:200
msgid ""
"Use “Remover com segurança” antes de desconectar o disco (ou desligue o "
"computador). Desligamentos bruscos podem corromper arquivos."
msgstr "Use “Safely remove” before disconnecting the disk (or turn off the computer). Abrupt shutdowns can corrupt files."

#: nuvem_ruscher/core/storage.py:207
msgid "Disco formatado no Windows (NTFS)"
msgstr "Disk formatted on Windows (NTFS)"

#: nuvem_ruscher/core/storage.py:208
msgid "Funciona bem para guardar fotos. Só pedimos três cuidados."
msgstr "It works well for storing photos. We only ask for three precautions."

#: nuvem_ruscher/core/storage.py:212
msgid ""
"Se você usa esse disco no Windows, desative lá a “Inicialização rápida”; "
"senão o Linux pode abri-lo apenas para leitura."
msgstr "If you use this disk on Windows, turn off “Fast Startup” there; otherwise Linux may open it as read-only."

#: nuvem_ruscher/core/storage.py:216
msgid ""
"Ele é um pouco mais lento que um disco formatado para Linux: as miniaturas "
"podem demorar mais na primeira vez."
msgstr "It is a bit slower than a disk formatted for Linux: thumbnails may take longer the first time."

#: nuvem_ruscher/core/storage.py:227
msgid "Disco no formato exFAT"
msgstr "Disk in exFAT format"

#: nuvem_ruscher/core/storage.py:228
msgid "Funciona para guardar fotos, com dois cuidados."
msgstr "It works for storing photos, with two precautions."

#: nuvem_ruscher/core/storage.py:231
msgid ""
"O exFAT não tem diário (journal): falhas de energia são mais arriscadas."
msgstr "exFAT has no journal: power failures are riskier."

#: nuvem_ruscher/core/storage.py:240
msgid "Este disco não aceita arquivos maiores que 4 GB"
msgstr "This disk does not accept files larger than 4 GB"

#: nuvem_ruscher/core/storage.py:242
msgid ""
"Ele está no formato FAT32. Fotos funcionam, mas vídeos longos não serão "
"salvos. Se puder, escolha outro disco."
msgstr "It is in FAT32 format. Photos work, but long videos will not be saved. If you can, choose another disk."

#: nuvem_ruscher/core/storage.py:252
#, python-brace-format
msgid "Sistema de arquivos pouco comum ({fs})"
msgstr "Uncommon file system ({fs})"

#: nuvem_ruscher/core/storage.py:253
msgid ""
"Não testamos esse formato. Pode funcionar, mas prefira ext4, Btrfs ou NTFS."
msgstr "We have not tested this format. It may work, but prefer ext4, Btrfs or NTFS."

#: nuvem_ruscher/core/validation.py:62
msgid "Escolha uma pasta para as fotos."
msgstr "Choose a folder for the photos."

#: nuvem_ruscher/core/validation.py:65
msgid "O caminho da pasta precisa começar com “/”."
msgstr "The folder path must start with “/”."

#: nuvem_ruscher/core/validation.py:67
msgid "O caminho da pasta é longo demais."
msgstr "The folder path is too long."

#: nuvem_ruscher/core/validation.py:69
msgid "O nome da pasta tem caracteres invisíveis não suportados."
msgstr "The folder name has unsupported invisible characters."

#: nuvem_ruscher/core/validation.py:72
#, python-brace-format
msgid "O nome da pasta não pode conter os caracteres: {chars}"
msgstr "The folder name cannot contain the characters: {chars}"

#: nuvem_ruscher/core/validation.py:75
msgid "O caminho da pasta não pode ter “.”, “..” ou barras duplas."
msgstr "The folder path cannot contain “.”, “..” or double slashes."

#: nuvem_ruscher/core/validation.py:77
msgid "Escolha uma pasta, não a raiz do sistema."
msgstr "Choose a folder, not the system root."

#: nuvem_ruscher/core/validation.py:81
#, python-brace-format
msgid "Essa pasta pertence ao sistema ({prefix}). Escolha uma pasta sua."
msgstr "This folder belongs to the system ({prefix}). Choose a folder of your own."

#: nuvem_ruscher/core/validation.py:84
msgid "Pastas em /run são temporárias. Escolha um disco de verdade."
msgstr "Folders in /run are temporary. Choose a real disk."

#: nuvem_ruscher/core/validation.py:95
#, python-brace-format
msgid "Versão inválida: {tag}"
msgstr "Invalid version: {tag}"

#: nuvem_ruscher/core/validation.py:146
msgid "muito fraca"
msgstr "very weak"

#: nuvem_ruscher/core/validation.py:147
msgid "fraca"
msgstr "weak"

#: nuvem_ruscher/core/validation.py:148
msgid "razoável"
msgstr "fair"

#: nuvem_ruscher/core/validation.py:149
msgid "boa"
msgstr "good"

#: nuvem_ruscher/core/validation.py:150
msgid "excelente"
msgstr "excellent"

#: nuvem_ruscher/main.py:16
msgid "Instala e cuida do Immich no BigLinux."
msgstr "Installs and looks after Immich on BigLinux."

#: nuvem_ruscher/main.py:20
msgid "finge todas as operações de sistema (nada é alterado)"
msgstr "fakes every system operation (nothing is changed)"

#: nuvem_ruscher/main.py:26
msgid "cenário da simulação; use “--cenario ajuda” para listar"
msgstr "simulation scenario; use “--cenario ajuda” to list them"

#: nuvem_ruscher/main.py:45
msgid "Não rode o Nuvem Ruscher como root: ele pede a senha só quando precisa."
msgstr "Do not run Nuvem Ruscher as root: it asks for the password only when needed."

#: nuvem_ruscher/main.py:58
#, python-brace-format
msgid "Cenário desconhecido: {name}. Use --cenario ajuda."
msgstr "Unknown scenario: {name}. Use --cenario ajuda."

#: nuvem_ruscher/ui/application.py:48
msgid "Abrir o Immich no navegador"
msgstr "Open Immich in the browser"

#: nuvem_ruscher/ui/application.py:51 nuvem_ruscher/ui/application.py:95
msgid "Atalhos de teclado"
msgstr "Keyboard shortcuts"

#: nuvem_ruscher/ui/application.py:52
#, python-brace-format
msgid "Sobre o {name}"
msgstr "About {name}"

#: nuvem_ruscher/ui/application.py:71
msgid "simulação"
msgstr "simulation"

#: nuvem_ruscher/ui/application.py:76
msgid ""
"Instala, configura e cuida do Immich — sua alternativa livre ao Google Fotos "
"— neste computador, com as fotos guardadas no disco que você escolher."
msgstr "Installs, configures and looks after Immich — your free alternative to Google Photos — on this computer, with the photos stored on the disk you choose."

#: nuvem_ruscher/ui/application.py:80
msgid "Documentação do Immich"
msgstr "Immich documentation"

#: nuvem_ruscher/ui/application.py:91
msgid "Geral"
msgstr "General"

#: nuvem_ruscher/ui/application.py:93
msgid "Sair"
msgstr "Quit"

#: nuvem_ruscher/ui/application.py:94
msgid "Fechar a janela"
msgstr "Close the window"

#: nuvem_ruscher/ui/application.py:96
msgid "Voltar no assistente"
msgstr "Go back in the assistant"

#: nuvem_ruscher/ui/application.py:100
msgid "Painel"
msgstr "Dashboard"

#: nuvem_ruscher/ui/application.py:102
#: nuvem_ruscher/ui/dashboard/__init__.py:44
msgid "Início"
msgstr "Home"

#: nuvem_ruscher/ui/application.py:103
#: nuvem_ruscher/ui/dashboard/__init__.py:45
#: nuvem_ruscher/ui/wizard/pages.py:1177 nuvem_ruscher/ui/wizard/pages.py:1178
msgid "Celular"
msgstr "Phone"

#: nuvem_ruscher/ui/application.py:104
#: nuvem_ruscher/ui/dashboard/__init__.py:46
msgid "Registros"
msgstr "Logs"

#: nuvem_ruscher/ui/application.py:105
#: nuvem_ruscher/ui/dashboard/__init__.py:47
msgid "Backups"
msgstr "Backups"

#: nuvem_ruscher/ui/application.py:106
#: nuvem_ruscher/ui/dashboard/__init__.py:48
#: nuvem_ruscher/ui/dashboard/updates.py:337
msgid "Atualizar"
msgstr "Update"

#: nuvem_ruscher/ui/application.py:107
#: nuvem_ruscher/ui/dashboard/__init__.py:49
msgid "Mais"
msgstr "More"

#: nuvem_ruscher/ui/application.py:108
msgid "Atualizar informações"
msgstr "Refresh information"

#: nuvem_ruscher/ui/application.py:109
msgid "Buscar nos registros"
msgstr "Search the logs"

#: nuvem_ruscher/ui/common.py:13
msgid "Concluído"
msgstr "Done"

#: nuvem_ruscher/ui/common.py:14
msgid "Atenção"
msgstr "Warning"

#: nuvem_ruscher/ui/common.py:15
msgid "Problema"
msgstr "Problem"

#: nuvem_ruscher/ui/common.py:16
msgid "Informação"
msgstr "Information"

