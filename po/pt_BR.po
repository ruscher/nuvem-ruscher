#: nuvem_ruscher/backend/base.py:282 nuvem_ruscher/ui/wizard/pages.py:111
msgid "Docker installed"
msgstr "Docker instalado"

#: nuvem_ruscher/backend/base.py:282
#, python-brace-format
msgid "Version {v}"
msgstr "Versão {v}"

#: nuvem_ruscher/backend/base.py:286
msgid "Docker is not installed"
msgstr "O Docker não está instalado"

#: nuvem_ruscher/backend/base.py:287
msgid ""
"It is the program that runs the photo server. Installation is automatic."
msgstr "É o programa que roda o servidor de fotos. A instalação é automática."

#: nuvem_ruscher/backend/base.py:288 nuvem_ruscher/ui/wizard/pages.py:606
msgid "Install"
msgstr "Instalar"

#: nuvem_ruscher/backend/base.py:293 nuvem_ruscher/backend/base.py:295
#: nuvem_ruscher/ui/wizard/pages.py:112
msgid "Docker running"
msgstr "Docker ligado"

#: nuvem_ruscher/backend/base.py:293 nuvem_ruscher/backend/base.py:319
msgid "Waiting for the installation"
msgstr "Aguardando a instalação"

#: nuvem_ruscher/backend/base.py:299
msgid "Docker is turned off"
msgstr "O Docker está desligado"

#: nuvem_ruscher/backend/base.py:300
msgid "We will turn it on now and have it start with the computer."
msgstr "Vamos ligá-lo agora e deixá-lo ligando junto com o computador."

#: nuvem_ruscher/backend/base.py:301 nuvem_ruscher/ui/dashboard/overview.py:228
#: nuvem_ruscher/ui/dashboard/overview.py:245
msgid "Turn on"
msgstr "Ligar"

#: nuvem_ruscher/backend/base.py:306
msgid "Your user can use Docker"
msgstr "Seu usuário pode usar o Docker"

#: nuvem_ruscher/backend/base.py:311
msgid "Permission granted"
msgstr "Permissão concedida"

#: nuvem_ruscher/backend/base.py:312
msgid ""
"It already works. When you can, log out and back in to complete the change."
msgstr ""
"Já funciona. Quando puder, saia e entre na sessão para completar o ajuste."

#: nuvem_ruscher/backend/base.py:318 nuvem_ruscher/ui/wizard/pages.py:113
msgid "Permission to use Docker"
msgstr "Permissão para usar o Docker"

#: nuvem_ruscher/backend/base.py:324
msgid "Your user cannot use Docker yet"
msgstr "Seu usuário ainda não pode usar o Docker"

#: nuvem_ruscher/backend/base.py:325
#, python-brace-format
msgid "We need to add “{user}” to the docker group."
msgstr "Precisamos colocar “{user}” no grupo docker."

#: nuvem_ruscher/backend/base.py:326
msgid "Allow"
msgstr "Permitir"

#: nuvem_ruscher/backend/base.py:330
#, python-brace-format
msgid "Memory: {size}"
msgstr "Memória: {size}"

#: nuvem_ruscher/backend/base.py:333
#, python-brace-format
msgid "The minimum is {n} GB"
msgstr "O mínimo é {n} GB"

#: nuvem_ruscher/backend/base.py:339
msgid ""
"Below the recommended amount. We will turn off face recognition so it fits."
msgstr ""
"Abaixo do recomendado. Vamos desligar o reconhecimento de rostos para caber."

#: nuvem_ruscher/backend/base.py:345
#, python-brace-format
msgid "Immich needs at least {n} GB of memory."
msgstr "O Immich precisa de pelo menos {n} GB de memória."

#: nuvem_ruscher/backend/base.py:349
#, python-brace-format
msgid "Processor: {n} cores"
msgstr "Processador: {n} núcleos"

#: nuvem_ruscher/backend/base.py:355
msgid "Old processor: artificial intelligence will be turned off."
msgstr "Processador antigo: a inteligência artificial ficará desligada."

#: nuvem_ruscher/backend/base.py:358
msgid "It will work, but slowly."
msgstr "Vai funcionar, mas devagar."

#: nuvem_ruscher/backend/base.py:363
#, python-brace-format
msgid "Space on the system disk: {size} free"
msgstr "Espaço no disco do sistema: {size} livres"

#: nuvem_ruscher/backend/base.py:365
msgid "The components take up about 5 GB"
msgstr "Os componentes ocupam cerca de 5 GB"

#: nuvem_ruscher/backend/base.py:369 nuvem_ruscher/core/helper_protocol.py:109
msgid "Not enough space on the system disk"
msgstr "Falta espaço no disco do sistema"

#: nuvem_ruscher/backend/base.py:370
#, python-brace-format
msgid "Free up {size} more to download the components."
msgstr "Libere mais {size} para baixar os componentes."

#: nuvem_ruscher/backend/base.py:375
#, python-brace-format
msgid "Port {p} is free"
msgstr "Porta {p} livre"

#: nuvem_ruscher/backend/base.py:378
#, python-brace-format
msgid "Port {p} already belongs to your Immich"
msgstr "Porta {p} já é do seu Immich"

#: nuvem_ruscher/backend/base.py:381
#, python-brace-format
msgid ""
"It is used by “{name}”. Close that program or stop the other Immich, then "
"check again."
msgstr ""
"Ela está sendo usada por “{name}”. Feche esse programa ou pare o outro "
"Immich e verifique de novo."

#: nuvem_ruscher/backend/base.py:384
msgid "Close that program or stop the other Immich, then check again."
msgstr "Feche esse programa ou pare o outro Immich e verifique de novo."

#: nuvem_ruscher/backend/base.py:386
#, python-brace-format
msgid "Another program is using port {p}"
msgstr "Outro programa está usando a porta {p}"

#: nuvem_ruscher/backend/base.py:390
msgid "Connected to the internet"
msgstr "Conectado à internet"

#: nuvem_ruscher/backend/base.py:394
msgid "No internet connection"
msgstr "Sem conexão com a internet"

#: nuvem_ruscher/backend/base.py:395
msgid "It is only needed now, to download the components."
msgstr "Ela só é necessária agora, para baixar os componentes."

#: nuvem_ruscher/backend/base.py:400
msgid "No firewall blocking"
msgstr "Nenhum firewall bloqueando"

#: nuvem_ruscher/backend/base.py:405
msgid "Firewall open to the home network"
msgstr "Firewall liberado para a rede de casa"

#: nuvem_ruscher/backend/base.py:406
#, python-brace-format
msgid "Port {p} open only to local networks and Tailscale"
msgstr "Porta {p} aberta só para redes locais e Tailscale"

#: nuvem_ruscher/backend/base.py:411
#, python-brace-format
msgid "Firewall active ({name})"
msgstr "Firewall ativo ({name})"

#: nuvem_ruscher/backend/base.py:412
#, python-brace-format
msgid "Open port {p} so the phone can find the server on the home network."
msgstr ""
"Libere a porta {p} para que o celular encontre o servidor na rede de casa."

#: nuvem_ruscher/backend/base.py:413 nuvem_ruscher/ui/dashboard/more.py:87
msgid "Open port"
msgstr "Liberar"

#: nuvem_ruscher/backend/simulated.py:85
msgid "first installation, everything fine (default)"
msgstr "primeira instalação, tudo certo (padrão)"

#: nuvem_ruscher/backend/simulated.py:86
msgid "opens straight on the dashboard"
msgstr "abre direto no painel"

#: nuvem_ruscher/backend/simulated.py:87
msgid "dashboard with an update available (with breaking changes)"
msgstr "painel com atualização disponível (com mudanças incompatíveis)"

#: nuvem_ruscher/backend/simulated.py:88
msgid "update that fails and rolls back by itself"
msgstr "atualização que falha e volta sozinha"

#: nuvem_ruscher/backend/simulated.py:89
msgid "Docker missing"
msgstr "Docker ausente"

#: nuvem_ruscher/backend/simulated.py:90
msgid "Docker installed but turned off"
msgstr "Docker instalado, mas desligado"

#: nuvem_ruscher/backend/simulated.py:91
msgid "user not in the docker group"
msgstr "usuário fora do grupo docker"

#: nuvem_ruscher/backend/simulated.py:92
msgid "just joined the docker group (old session)"
msgstr "acabou de entrar no grupo docker (sessão antiga)"

#: nuvem_ruscher/backend/simulated.py:93
msgid "photo disk disconnected"
msgstr "disco das fotos desconectado"

#: nuvem_ruscher/backend/simulated.py:94
msgid "NTFS disk (like this machine)"
msgstr "disco NTFS (como nesta máquina)"

#: nuvem_ruscher/backend/simulated.py:95
msgid "FAT32 disk (4 GB limit)"
msgstr "disco FAT32 (limite de 4 GB)"

#: nuvem_ruscher/backend/simulated.py:96
msgid "ext4 disk (no warnings)"
msgstr "disco ext4 (sem avisos)"

#: nuvem_ruscher/backend/simulated.py:97
msgid "port 2283 in use"
msgstr "porta 2283 ocupada"

#: nuvem_ruscher/backend/simulated.py:98
msgid "no internet"
msgstr "sem internet"

#: nuvem_ruscher/backend/simulated.py:99
msgid "5 GB of memory"
msgstr "5 GB de memória"

#: nuvem_ruscher/backend/simulated.py:100
msgid "reinstallation with existing photos and account"
msgstr "reinstalação com fotos e conta existentes"

#: nuvem_ruscher/backend/simulated.py:101
msgid "image download fails halfway"
msgstr "download das imagens falha no meio"

#: nuvem_ruscher/backend/simulated.py:102
msgid "server takes long to become ready"
msgstr "servidor demora a ficar pronto"

#: nuvem_ruscher/backend/simulated.py:103
msgid "ufw firewall active"
msgstr "firewall ufw ativo"

#: nuvem_ruscher/backend/simulated.py:104
msgid "automatic mounting already configured"
msgstr "montagem automática já configurada"

#: nuvem_ruscher/core/docker.py:84
msgid "Server"
msgstr "Servidor"

#: nuvem_ruscher/core/docker.py:85
msgid "Artificial intelligence"
msgstr "Inteligência artificial"

#: nuvem_ruscher/core/docker.py:86
msgid "Database"
msgstr "Banco de dados"

#: nuvem_ruscher/core/docker.py:87
msgid "Cache"
msgstr "Cache"

#: nuvem_ruscher/core/docker.py:91
msgid "Website, app and photo uploads"
msgstr "Site, aplicativo e envio de fotos"

#: nuvem_ruscher/core/docker.py:92
msgid "Faces and smart search"
msgstr "Rostos e busca inteligente"

#: nuvem_ruscher/core/docker.py:93
msgid "Albums, people and photo information"
msgstr "Álbuns, pessoas e informações das fotos"

#: nuvem_ruscher/core/docker.py:94
msgid "Task queue"
msgstr "Fila de tarefas"

#: nuvem_ruscher/core/helper_protocol.py:37
msgid "Authorization was canceled"
msgstr "A autorização foi cancelada"

#: nuvem_ruscher/core/helper_protocol.py:38
msgid ""
"Nothing was changed. Try again and type the administrator password when "
"asked."
msgstr ""
"Nada foi alterado. Tente de novo e digite a senha de administrador quando "
"ela for pedida."

#: nuvem_ruscher/core/helper_protocol.py:41
msgid "Your user does not have administrator permission"
msgstr "Seu usuário não tem permissão de administrador"

#: nuvem_ruscher/core/helper_protocol.py:42
msgid ""
"Ask someone with administrator access to open Nuvem Ruscher and do this step."
msgstr ""
"Peça para alguém com acesso de administrador abrir o Nuvem Ruscher e fazer "
"esta etapa."

#: nuvem_ruscher/core/helper_protocol.py:45
msgid "Nuvem Ruscher is not fully installed"
msgstr "O Nuvem Ruscher não está instalado por completo"

#: nuvem_ruscher/core/helper_protocol.py:46
msgid ""
"Install the nuvem-ruscher package (or run “sudo make install”) and open the "
"app again."
msgstr ""
"Instale o pacote nuvem-ruscher (ou rode “sudo make install”) e abra o app de "
"novo."

#: nuvem_ruscher/core/helper_protocol.py:49
msgid "Some data sent did not pass the security check"
msgstr "Um dado enviado não passou na verificação de segurança"

#: nuvem_ruscher/core/helper_protocol.py:50
msgid "Nothing was changed. Check the chosen folder and try again."
msgstr "Nada foi alterado. Confira a pasta escolhida e tente de novo."

#: nuvem_ruscher/core/helper_protocol.py:53
#: nuvem_ruscher/ui/dashboard/overview.py:217
msgid "The photo disk is not connected"
msgstr "O disco das fotos não está conectado"

#: nuvem_ruscher/core/helper_protocol.py:54
msgid ""
"Connect the disk, wait for it to appear in the file manager and try again."
msgstr ""
"Conecte o disco, espere ele aparecer no gerenciador de arquivos e tente de "
"novo."

#: nuvem_ruscher/core/helper_protocol.py:57
msgid "The photo folder is not in a safe place"
msgstr "A pasta das fotos não está num lugar seguro"

#: nuvem_ruscher/core/helper_protocol.py:58
msgid "Choose a folder inside a mounted disk. Nothing was changed."
msgstr "Escolha uma pasta dentro de um disco montado. Nada foi alterado."

#: nuvem_ruscher/core/helper_protocol.py:61
msgid "Could not download the Immich files"
msgstr "Não foi possível baixar os arquivos do Immich"

#: nuvem_ruscher/core/helper_protocol.py:62
msgid ""
"Check the internet connection and try again. The process resumes where it "
"stopped."
msgstr ""
"Verifique a internet e tente de novo. O processo continua de onde parou."

#: nuvem_ruscher/core/helper_protocol.py:65
msgid "Package installation failed"
msgstr "A instalação de pacotes falhou"

#: nuvem_ruscher/core/helper_protocol.py:66
msgid ""
"Update the system through the software store (or “sudo pacman -Syu”) and try "
"again."
msgstr ""
"Atualize o sistema pela loja de programas (ou “sudo pacman -Syu”) e tente de "
"novo."

#: nuvem_ruscher/core/helper_protocol.py:69
msgid "This disk already has a mount rule"
msgstr "Esse disco já tem uma regra de montagem"

#: nuvem_ruscher/core/helper_protocol.py:70
msgid "It is already configured in the system. No changes were made."
msgstr "Ele já está configurado no sistema. Nenhuma alteração foi feita."

#: nuvem_ruscher/core/helper_protocol.py:73
msgid "The mount rule did not pass the check"
msgstr "A regra de montagem não passou na verificação"

#: nuvem_ruscher/core/helper_protocol.py:74
msgid "Nothing was changed: the original file was restored automatically."
msgstr "Nada foi alterado: o arquivo original foi restaurado automaticamente."

#: nuvem_ruscher/core/helper_protocol.py:77
msgid "This type of disk cannot be mounted automatically"
msgstr "Esse tipo de disco não pode ser montado automaticamente"

#: nuvem_ruscher/core/helper_protocol.py:78
msgid "The server still works, but only after you log in and open the disk."
msgstr ""
"O servidor ainda funciona, mas só depois que você entrar na sessão e abrir o "
"disco."

#: nuvem_ruscher/core/helper_protocol.py:81
msgid "There is an old database without its matching password"
msgstr "Existe um banco de dados antigo sem a senha correspondente"

#: nuvem_ruscher/core/helper_protocol.py:82
msgid ""
"To avoid losing anything, the installation stopped. See the technical "
"details to recover."
msgstr ""
"Para não perder nada, a instalação parou. Veja os detalhes técnicos para "
"recuperar."

#: nuvem_ruscher/core/helper_protocol.py:85
#: nuvem_ruscher/ui/dashboard/overview.py:212
msgid "The server could not start"
msgstr "O servidor não conseguiu ligar"

#: nuvem_ruscher/core/helper_protocol.py:86
msgid ""
"Check that the photo disk is connected and see the logs for more details."
msgstr ""
"Confira se o disco das fotos está conectado e veja os registros para mais "
"detalhes."

#: nuvem_ruscher/core/helper_protocol.py:89
msgid "The server has not been installed yet"
msgstr "O servidor ainda não foi instalado"

#: nuvem_ruscher/core/helper_protocol.py:90
msgid "Run the setup assistant first."
msgstr "Rode o assistente de instalação primeiro."

#: nuvem_ruscher/core/helper_protocol.py:93
#: nuvem_ruscher/ui/dashboard/overview.py:202
msgid "The server is turned off"
msgstr "O servidor está desligado"

#: nuvem_ruscher/core/helper_protocol.py:94
msgid "Turn on the server and try again."
msgstr "Ligue o servidor e tente de novo."

#: nuvem_ruscher/core/helper_protocol.py:97
msgid "The database backup failed"
msgstr "O backup do banco de dados falhou"

#: nuvem_ruscher/core/helper_protocol.py:98
msgid "Check the free space on the photo disk and try again."
msgstr "Confira o espaço livre no disco das fotos e tente de novo."

#: nuvem_ruscher/core/helper_protocol.py:101
msgid "The update did not work, but everything is back as it was"
msgstr "A atualização não deu certo, mas tudo voltou como estava"

#: nuvem_ruscher/core/helper_protocol.py:102
msgid ""
"Your server is still on the previous version, with all its data. See the "
"technical details."
msgstr ""
"Seu servidor continua na versão anterior, com todos os dados. Veja os "
"detalhes técnicos."

#: nuvem_ruscher/core/helper_protocol.py:105
msgid "The update failed and so did the automatic rollback"
msgstr "A atualização falhou e a volta automática também"

#: nuvem_ruscher/core/helper_protocol.py:106
msgid ""
"Your photos are safe on the disk. See the technical details: a copy of the "
"database was kept."
msgstr ""
"Suas fotos estão seguras no disco. Veja os detalhes técnicos: há uma cópia "
"do banco guardada."

#: nuvem_ruscher/core/helper_protocol.py:110
msgid "Free up space and try again."
msgstr "Libere espaço e tente de novo."

#: nuvem_ruscher/core/helper_protocol.py:113
msgid "Could not adjust the firewall"
msgstr "Não foi possível ajustar o firewall"

#: nuvem_ruscher/core/helper_protocol.py:114
msgid "You can open port 2283 manually in the firewall settings."
msgstr ""
"Você pode liberar a porta 2283 manualmente nas configurações do firewall."

#: nuvem_ruscher/core/helper_protocol.py:117
msgid "Something unexpected happened"
msgstr "Algo inesperado aconteceu"

#: nuvem_ruscher/core/helper_protocol.py:118
msgid ""
"Nothing in your photos was changed. See the technical details and try again."
msgstr ""
"Nada nas suas fotos foi alterado. Veja os detalhes técnicos e tente de novo."

#: nuvem_ruscher/core/storage.py:196
msgid ""
"The Immich database does not go on this disk: it goes on the internal disk, "
"as the official documentation requires."
msgstr ""
"O banco de dados do Immich não fica nesse disco: ele vai para o disco "
"interno, como a documentação oficial exige."

#: nuvem_ruscher/core/storage.py:200
msgid ""
"Use “Safely remove” before disconnecting the disk (or turn off the "
"computer). Abrupt shutdowns can corrupt files."
msgstr ""
"Use “Remover com segurança” antes de desconectar o disco (ou desligue o "
"computador). Desligamentos bruscos podem corromper arquivos."

#: nuvem_ruscher/core/storage.py:207
msgid "Disk formatted on Windows (NTFS)"
msgstr "Disco formatado no Windows (NTFS)"

#: nuvem_ruscher/core/storage.py:208
msgid "It works well for storing photos. We only ask for three precautions."
msgstr "Funciona bem para guardar fotos. Só pedimos três cuidados."

#: nuvem_ruscher/core/storage.py:212
msgid ""
"If you use this disk on Windows, turn off “Fast Startup” there; otherwise "
"Linux may open it as read-only."
msgstr ""
"Se você usa esse disco no Windows, desative lá a “Inicialização rápida”; "
"senão o Linux pode abri-lo apenas para leitura."

#: nuvem_ruscher/core/storage.py:215
msgid ""
"It is a bit slower than a disk formatted for Linux: thumbnails may take "
"longer the first time."
msgstr ""
"Ele é um pouco mais lento que um disco formatado para Linux: as miniaturas "
"podem demorar mais na primeira vez."

#: nuvem_ruscher/core/storage.py:224
msgid "Disk in exFAT format"
msgstr "Disco no formato exFAT"

#: nuvem_ruscher/core/storage.py:225
msgid "It works for storing photos, with two precautions."
msgstr "Funciona para guardar fotos, com dois cuidados."

#: nuvem_ruscher/core/storage.py:228
msgid "exFAT has no journal: power failures are riskier."
msgstr ""
"O exFAT não tem diário (journal): falhas de energia são mais arriscadas."

#: nuvem_ruscher/core/storage.py:237
msgid "This disk does not accept files larger than 4 GB"
msgstr "Este disco não aceita arquivos maiores que 4 GB"

#: nuvem_ruscher/core/storage.py:239
msgid ""
"It is in FAT32 format. Photos work, but long videos will not be saved. If "
"you can, choose another disk."
msgstr ""
"Ele está no formato FAT32. Fotos funcionam, mas vídeos longos não serão "
"salvos. Se puder, escolha outro disco."

#: nuvem_ruscher/core/storage.py:249
#, python-brace-format
msgid "Uncommon file system ({fs})"
msgstr "Sistema de arquivos pouco comum ({fs})"

#: nuvem_ruscher/core/storage.py:250
msgid ""
"We have not tested this format. It may work, but prefer ext4, Btrfs or NTFS."
msgstr ""
"Não testamos esse formato. Pode funcionar, mas prefira ext4, Btrfs ou NTFS."

#: nuvem_ruscher/core/validation.py:62
msgid "Choose a folder for the photos."
msgstr "Escolha uma pasta para as fotos."

#: nuvem_ruscher/core/validation.py:65
msgid "The folder path must start with “/”."
msgstr "O caminho da pasta precisa começar com “/”."

#: nuvem_ruscher/core/validation.py:67
msgid "The folder path is too long."
msgstr "O caminho da pasta é longo demais."

#: nuvem_ruscher/core/validation.py:69
msgid "The folder name has unsupported invisible characters."
msgstr "O nome da pasta tem caracteres invisíveis não suportados."

#: nuvem_ruscher/core/validation.py:72
#, python-brace-format
msgid "The folder name cannot contain the characters: {chars}"
msgstr "O nome da pasta não pode conter os caracteres: {chars}"

#: nuvem_ruscher/core/validation.py:75
msgid "The folder path cannot contain “.”, “..” or double slashes."
msgstr "O caminho da pasta não pode ter “.”, “..” ou barras duplas."

#: nuvem_ruscher/core/validation.py:77
msgid "Choose a folder, not the system root."
msgstr "Escolha uma pasta, não a raiz do sistema."

#: nuvem_ruscher/core/validation.py:81
#, python-brace-format
msgid ""
"This folder belongs to the system ({prefix}). Choose a folder of your own."
msgstr "Essa pasta pertence ao sistema ({prefix}). Escolha uma pasta sua."

#: nuvem_ruscher/core/validation.py:84
msgid "Folders in /run are temporary. Choose a real disk."
msgstr "Pastas em /run são temporárias. Escolha um disco de verdade."

#: nuvem_ruscher/core/validation.py:95
#, python-brace-format
msgid "Invalid version: {tag}"
msgstr "Versão inválida: {tag}"

#: nuvem_ruscher/core/validation.py:146
msgid "very weak"
msgstr "muito fraca"

#: nuvem_ruscher/core/validation.py:147
msgid "weak"
msgstr "fraca"

#: nuvem_ruscher/core/validation.py:148
msgid "fair"
msgstr "razoável"

#: nuvem_ruscher/core/validation.py:149
msgid "good"
msgstr "boa"

#: nuvem_ruscher/core/validation.py:150
msgid "excellent"
msgstr "excelente"

#: nuvem_ruscher/main.py:17
msgid "Installs and looks after Immich on BigLinux."
msgstr "Instala e cuida do Immich no BigLinux."

#: nuvem_ruscher/main.py:25
msgid "fakes every system operation (nothing is changed)"
msgstr "finge todas as operações de sistema (nada é alterado)"

#: nuvem_ruscher/main.py:32
msgid "NAME"
msgstr "NOME"

#: nuvem_ruscher/main.py:33
msgid "simulation scenario; use “--scenario help” to list them"
msgstr "cenário da simulação; use “--scenario help” para listar"

#: nuvem_ruscher/main.py:52
msgid ""
"Do not run Nuvem Ruscher as root: it asks for the password only when needed."
msgstr ""
"Não rode o Nuvem Ruscher como root: ele pede a senha só quando precisa."

#: nuvem_ruscher/main.py:66
#, python-brace-format
msgid "Unknown scenario: {name}. Use --scenario help."
